## Supabase (somente servidor — nunca use o prefixo NEXT_PUBLIC_)
# URL do projeto Supabase (Project Settings > API)
SUPABASE_URL=
# Secret key / service role. Dá acesso total ao banco: nunca expor ao cliente nem commitar.
SUPABASE_SECRET_KEY=

# URL do mesmo projeto e chave pública anon para SSR e leituras públicas restritas
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
